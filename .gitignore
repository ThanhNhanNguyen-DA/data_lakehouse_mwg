/.docs
/.vs

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.env

# requests-cache khi debug crawler (MWG_HTTP_CACHE=1)
data/_state/http_cache.sqlite

# File gốc ở Bronze (PDF + ảnh, backfill ~170 file, có file ~19 MB): chưa đưa lên git.
# Quyết định lại ở tuần 9 khi làm GitHub Actions (commit PDF hay chỉ commit Silver/Gold).
data/bronze/**/*.pdf
data/bronze/**/*.jpg
data/bronze/**/*.png

# Cache OCR theo sha256 + trang (tạo lại được)
data/_cache/

# Trang duyệt ô gợi ý sửa (sinh lại được, chứa ảnh crop từ PDF)
review/

# Bảng ô thô (sinh lại từ Bronze + cache OCR mỗi lần bóc tách, lớn dần theo phiên bản): không đưa lên git.
# Silver fin_statement_long và Gold (data/gold) được commit để dashboard trên Streamlit Cloud đọc được.
data/silver/fs_extracted_raw/

# Khóa chống chạy pipeline đồng thời (run_pipeline.py)
data/_state/pipeline.lock

# Gold dựng lại mỗi lần chạy; Streamlit Cloud đọc bản chụp dashboard/snapshot/mwg.duckdb (được commit)
data/gold/*
!data/gold/.gitkeep
